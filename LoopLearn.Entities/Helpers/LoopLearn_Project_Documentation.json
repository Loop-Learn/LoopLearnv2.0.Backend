  "knownIssues": [
    {
      "id": 1,
      "title": "UpdateCourse Transaction Management",
      "severity": "High",
      "description": "SaveAsync() called multiple times within UpdateCourse, risking partial updates",
      "impact": "Orphaned sections/lessons if operation fails mid-way",
      "recommendation": "Use DbContextTransaction for atomicity"
    },
    {
      "id": 2,
      "title": "N+1 Query Problem",
      "severity": "Medium",
      "description": "GetCoursesById includes multiple navigation properties causing multiple queries",
      "impact": "Performance degradation with large datasets",
      "recommendation": "Use projection/SelectMany for specific needs"
    },
    {
      "id": 3,
      "title": "No Soft Delete Implementation",
      "severity": "Medium",
      "description": "Cascade delete loses student progress and enrollment data",
      "impact": "Data loss and audit trail loss",
      "recommendation": "Add IsDeleted flag to Course and related entities"
    },
    {
      "id": 4,
      "title": "No Concurrency Control",
      "severity": "Medium",
      "description": "No optimistic locking (RowVersion) implemented",
      "impact": "Multiple users could corrupt course data",
      "recommendation": "Add [Timestamp] property to Course model"
    },
    {
      "id": 5,
      "title": "No Rate Limiting",
      "severity": "Low",
      "description": "API has no throttling or rate limiting",
      "recommendation": "Implement AspNetCoreRateLimit middleware"
    },
    {
      "id": 6,
      "title": "No Caching Strategy",
      "severity": "Low",
      "description": "No caching layer implemented",
      "recommendation": "Add Redis for categories and popular courses"
    },
    {
      "id": 7,
      "title": "No File Upload Capability",
      "severity": "Medium",
      "description": "Courses use URLs only, no file upload",
      "recommendation": "Implement Azure Blob Storage or AWS S3"
    }
  ],
