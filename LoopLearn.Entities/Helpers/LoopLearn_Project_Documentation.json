      },
      {
        "name": "Dependency Injection",
        "description": "Constructor-based dependency injection",
        "scope": "Scoped for DbContext"
      },
      {
        "name": "DTO Pattern",
        "description": "Decouples API contracts from models",
        "examples": [
          "CourseCreationDTO",
          "UpdateCourseDTO",
          "CourseDetailDTO"
        ]
      },
      {
        "name": "Async/Await",
        "description": "Non-blocking I/O operations"
      },
      {
        "name": "Custom Validation Attributes",
        "description": "Domain-specific validation rules",
        "examples": [
          "CourseTitle",
          "Username",
          "Email"
        ]
      }
    ]
