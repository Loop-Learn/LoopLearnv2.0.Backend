    "pattern": "Layered N-Tier Architecture",
    "layers": [
      {
        "name": "Presentation Layer",
        "project": "LoopLearn.API",
        "responsibilities": [
          "HTTP endpoints (Controllers)",
          "Request/Response handling",
          "Input validation",
          "Authorization enforcement"
        ]
      },
      {
        "name": "Data Access & Services Layer",
        "project": "LoopLearn.DataAccess",
        "responsibilities": [
          "Repository implementations",
          "Unit of Work pattern",
          "Business services",
          "Database context",
          "Migrations"
        ]
      },
      {
        "name": "Domain/Entity Layer",
        "project": "LoopLearn.Entities",
        "responsibilities": [
          "Entity models",
          "Data transfer objects",
          "Repository interfaces",
          "Custom validation",
          "Exception types",
          "Enums and constants"
        ]
      },
      {
        "name": "Persistence Layer",
        "project": "SQL Server Database",
        "responsibilities": [
          "Relational data storage",
          "Identity management",
          "Transaction management"
        ]
      }
    ],
    "designPatterns": [
